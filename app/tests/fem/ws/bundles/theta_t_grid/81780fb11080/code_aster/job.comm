# Generated by fem-client: Code_Aster periodic homogenisation (plane stress).
# Periodic pairing: LIAISON_GROUP with TRAN (Lagrange multipliers); stress: volume average of SIGM_ELGA.
import json
P = json.load(open("params.json"))
L = P["L"]
DEBUT(LANG="EN", PAR_LOT="NON")
mesh = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(GROUP_MA="solid", PHENOMENE="MECANIQUE", MODELISATION="C_PLAN"))
mat = DEFI_MATERIAU(ELAS=_F(E=P["E"], NU=P["nu"]))
cmat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=_F(GROUP_MA="solid", MATER=mat))
fix = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(GROUP_NO="anchor", DX=0.0, DY=0.0))
averages = []
for k, (exx, eyy, gxy) in enumerate(P["strain_cases"]):
    exy = gxy / 2.0
    rel = []
    for ddl, val in (("DX", exx * L), ("DY", exy * L)):
        rel.append(_F(GROUP_MA_1="right", GROUP_MA_2="left", DDL_1=ddl, COEF_MULT_1=1.0,
                      DDL_2=ddl, COEF_MULT_2=-1.0, COEF_IMPO=val, TRAN=(-L, 0.0)))
    for ddl, val in (("DX", exy * L), ("DY", eyy * L)):
        kw = dict(GROUP_MA_1="top", GROUP_MA_2="bottom", DDL_1=ddl, COEF_MULT_1=1.0,
                  DDL_2=ddl, COEF_MULT_2=-1.0, COEF_IMPO=val, TRAN=(0.0, -L))
        if P["has_corners"]:
            kw["SANS_GROUP_NO"] = "corner_tr"  # the corner relation is implied by the other three
        rel.append(_F(**kw))
    per = AFFE_CHAR_MECA(MODELE=model, LIAISON_GROUP=rel)
    res = MECA_STATIQUE(MODELE=model, CHAM_MATER=cmat, EXCIT=(_F(CHARGE=fix), _F(CHARGE=per)))
    res = CALC_CHAMP(reuse=res, RESULTAT=res, CONTRAINTE="SIGM_ELGA")
    tab = POST_ELEM(RESULTAT=res, MODELE=model,
                    INTEGRALE=_F(GROUP_MA="solid", NOM_CHAM="SIGM_ELGA", NOM_CMP=("SIXX", "SIYY", "SIXY"), TYPE_MAILLE="2D"))
    v = tab.EXTR_TABLE().values()
    averages.append([v["INTE_SIXX"][-1] / L ** 2, v["INTE_SIYY"][-1] / L ** 2, v["INTE_SIXY"][-1] / L ** 2])
    if k == 0:
        IMPR_RESU(FORMAT="MED", UNITE=80, RESU=_F(RESULTAT=res, NOM_CHAM=("DEPL", "SIGM_ELGA")))
try:
    import code_aster
    ver = getattr(code_aster, "__version__", "unknown")
except Exception:
    ver = "unknown"
json.dump({"schema": "fem-client/raw@1", "engine": "code_aster", "engine_version": ver,
           "strain_cases": P["strain_cases"], "stress_averages": averages,
           "pairing": "LIAISON_GROUP/TRAN", "stress_route": "volume average SIGM_ELGA",
           "fields": "fields_aster.med"}, open("results.json", "w"), indent=1)
FIN()
