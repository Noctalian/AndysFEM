# Generated by fem-client from the code window (Code_Aster command file)
import json
DEBUT(LANG='EN', PAR_LOT='NON')
mesh = LIRE_MAILLAGE(FORMAT='ASTER', UNITE=20)
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', PHENOMENE='MECANIQUE', MODELISATION='3D'))
m1 = DEFI_MATERIAU(ELAS=_F(E=2.1e5, NU=0.3, RHO=7.85e-9))
cmat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=(_F(GROUP_MA='MAT1', MATER=m1),))
d1 = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(GROUP_NO='D1', DX=0e0, DY=0e0, DZ=0e0))
fnod = AFFE_CHAR_MECA(MODELE=model, FORCE_NODALE=(_F(GROUP_NO='F51', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F102', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F153', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F204', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F255', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F306', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F357', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F408', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F459', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F510', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F561', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F612', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F663', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F714', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F765', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F816', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F867', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F918', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F969', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1020', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1071', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1122', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1173', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1224', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1275', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1326', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1377', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1428', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1479', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1530', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1581', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1632', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1683', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1734', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1785', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),
    _F(GROUP_NO='F1836', FX=0e0, FY=-2.777777777777778e1, FZ=0e0),))
res = MECA_STATIQUE(MODELE=model, CHAM_MATER=cmat, EXCIT=(_F(CHARGE=d1), _F(CHARGE=fnod),))
res = CALC_CHAMP(reuse=res, RESULTAT=res, FORCE='REAC_NODA', CONTRAINTE=('SIGM_ELNO', 'SIGM_NOEU'))
def comps(champ, typ, names):
    f = CREA_CHAMP(TYPE_CHAM=typ, OPERATION='EXTR', RESULTAT=res, NOM_CHAM=champ, NUME_ORDRE=1)
    out = {}
    for n in names:
        c = f.EXTR_COMP(n, [], 1)
        out[n] = dict(zip([int(k) for k in c.noeud], [float(v) for v in c.valeurs]))
    return out
U = comps('DEPL', 'NOEU_DEPL_R', ["DX", "DY", "DZ"])
R = comps('REAC_NODA', 'NOEU_DEPL_R', ["DX", "DY", "DZ"])
S = comps('SIGM_NOEU', 'NOEU_SIEF_R', ["SIXX", "SIYY", "SIZZ", "SIXY", "SIYZ", "SIXZ"])
order = json.load(open('node_order.json'))
try:
    import code_aster
    ver = getattr(code_aster, '__version__', 'unknown')
except Exception:
    ver = 'unknown'
json.dump({'engine': 'code_aster', 'engine_version': ver, 'force_scale': 1e0,
           'nodes': order,
           'U': [[U[c].get(i + 1, 0.0) for c in ["DX", "DY", "DZ"]] for i in range(len(order))],
           'RF': [[order[i], j, R[c].get(i + 1, 0.0)] for i in range(len(order)) for j, c in enumerate(["DX", "DY", "DZ"])],
           'S': [[S[c].get(i + 1, 0.0) for c in ["SIXX", "SIYY", "SIZZ", "SIXY", "SIYZ", "SIXZ"]] for i in range(len(order))]},
          open('results_fields.json', 'w'))
FIN()
