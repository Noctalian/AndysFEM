# Generated by fem-client from the code window (Code_Aster command file)
import json
DEBUT(LANG='EN', PAR_LOT='NON')
mesh = LIRE_MAILLAGE(FORMAT='ASTER', UNITE=20)
model = AFFE_MODELE(MAILLAGE=mesh, AFFE=_F(TOUT='OUI', PHENOMENE='MECANIQUE', MODELISATION='C_PLAN'))
m1 = DEFI_MATERIAU(ELAS=_F(E=7e4, NU=0.33, RHO=0e0))
cmat = AFFE_MATERIAU(MAILLAGE=mesh, AFFE=(_F(GROUP_MA='MAT1', MATER=m1),))
d1 = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(GROUP_NO='D1', DX=0e0))
d2 = AFFE_CHAR_MECA(MODELE=model, DDL_IMPO=_F(GROUP_NO='D2', DX=0e0, DY=0e0))
pres = AFFE_CHAR_MECA(MODELE=model, PRES_REP=(_F(GROUP_MA='PRES1', PRES=-1e1),))
res = MECA_STATIQUE(MODELE=model, CHAM_MATER=cmat, EXCIT=(_F(CHARGE=d1), _F(CHARGE=d2), _F(CHARGE=pres),))
res = CALC_CHAMP(reuse=res, RESULTAT=res, FORCE='REAC_NODA', CONTRAINTE=('SIGM_ELNO', 'SIGM_NOEU'))
def comps(champ, typ, names):
    f = CREA_CHAMP(TYPE_CHAM=typ, OPERATION='EXTR', RESULTAT=res, NOM_CHAM=champ, NUME_ORDRE=1)
    out = {}
    for n in names:
        c = f.EXTR_COMP(n, [], 1)
        out[n] = dict(zip([int(k) for k in c.noeud], [float(v) for v in c.valeurs]))
    return out
U = comps('DEPL', 'NOEU_DEPL_R', ["DX", "DY"])
R = comps('REAC_NODA', 'NOEU_DEPL_R', ["DX", "DY"])
S = comps('SIGM_NOEU', 'NOEU_SIEF_R', ["SIXX", "SIYY", "SIZZ", "SIXY"])
order = json.load(open('node_order.json'))
try:
    import code_aster
    ver = getattr(code_aster, '__version__', 'unknown')
except Exception:
    ver = 'unknown'
json.dump({'engine': 'code_aster', 'engine_version': ver, 'force_scale': 5e0,
           'nodes': order,
           'U': [[U[c].get(i + 1, 0.0) for c in ["DX", "DY"]] for i in range(len(order))],
           'RF': [[order[i], j, R[c].get(i + 1, 0.0)] for i in range(len(order)) for j, c in enumerate(["DX", "DY"])],
           'S': [[S[c].get(i + 1, 0.0) for c in ["SIXX", "SIYY", "SIZZ", "SIXY"]] for i in range(len(order))]},
          open('results_fields.json', 'w'))
FIN()
